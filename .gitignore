# Terraform working dirs and state: never commit
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfplan

# Real variable values and backend config: commit only the .example files
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Mac + editors
.DS_Store
.vscode/
